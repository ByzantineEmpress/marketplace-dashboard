[Unit]
Description=Back up the Marketplace Dashboard SQLite database
Documentation=file:///opt/marketplace-dashboard/docs/DEPLOY.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Optional off-host copy target, e.g. an S3 bucket. See deploy/backup-db.sh.
# Create /etc/default/marketplace-backup with:
#   OFFSITE_CMD='aws s3 cp "$1" s3://my-backups/marketplace/'
EnvironmentFile=-/etc/default/marketplace-backup
Environment=REPO_DIR=/opt/marketplace-dashboard
ExecStart=/usr/local/bin/marketplace-backup
# Modest hardening: the script only reads the DB and writes into ./data.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/marketplace-dashboard/data
