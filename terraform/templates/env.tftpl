# Generated by Terraform. Safe to edit, but note that Admin -> Settings in the
# app may rewrite this file — keep it out of version control.
ADMIN_USERNAME=${admin_username}
ADMIN_PASSWORD=${admin_password}

# Overridden by docker-compose.lightsail.yml to an absolute path under
# /app/data. Kept as the local-dev relative value so a bare `uvicorn` run works.
DATABASE_URL=sqlite:///./marketplace.db

APP_PORT=8000
APP_DEBUG=false
APP_BASE_URL=https://${domain}
REQUIRE_HTTPS=true
ALLOWED_ORIGINS=https://${domain}

SECRET_KEY=${secret_key}

GOOGLE_CLIENT_ID=${google_client_id}
GOOGLE_CLIENT_SECRET=${google_client_secret}
GOOGLE_ALLOWED_EMAILS=[]
GOOGLE_DEV_MODE=False

MAIL_BACKEND=http
MAIL_PROVIDER=resend
MAIL_API_KEY=${mail_api_key}
MAIL_FROM=${mail_from}

UPLOAD_BACKEND=local
S3_BUCKET=
S3_REGION=${aws_region}
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_DOWNLOAD=false

# Required by docker-compose.lightsail.yml, which marks it a mandatory
# variable. Cloudflare issues tunnel tokens only through the dashboard, so this
# is filled in after `tofu apply`:
#   Zero Trust -> Networks -> Tunnels -> <tunnel> -> copy the install token
CLOUDFLARE_TUNNEL_TOKEN=
