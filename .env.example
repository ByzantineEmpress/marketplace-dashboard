# .env — environment variables for local development
# Copy .env.example to .env and fill in your values

# ─── Admin Credentials ──────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# ─── Google Sign-In (optional — see docs/GOOGLE-LOGIN.md) ────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google emails allowed to sign in (empty = any account)
GOOGLE_ALLOWED_EMAILS=
# Enable local Google OAuth test simulator (bypasses Google Cloud for local dev)
GOOGLE_DEV_MODE=false

# ─── eBay API ───────────────────────────────────────────────────
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Leave commented to derive the callback from APP_BASE_URL. Setting it here
# OVERRIDES APP_BASE_URL (the adapters read os.environ first), so a localhost
# value left in a deployed .env makes the marketplace reject the redirect:
#   "An error occurred — The requested redirect URL is not permitted."
# Only uncomment if you need a callback URL that differs from APP_BASE_URL.
# EBAY_REDIRECT_URI=

# ─── Etsy API ───────────────────────────────────────────────────
ETSY_API_KEY=
ETSY_API_SECRET=
# Same as above: this overrides APP_BASE_URL when set. Etsy additionally
# requires the exact URI to be registered in your Etsy app's settings.
# ETSY_REDIRECT_URI=

# ─── Database ───────────────────────────────────────────────────
DATABASE_URL=sqlite:///./marketplace.db

# ─── App Settings ──────────────────────────────────────────────
APP_PORT=8000
APP_DEBUG=false
# Base URL the browser uses (must match the Google OAuth redirect host)
APP_BASE_URL=http://localhost:8000
# Dashboard auto-refresh interval in seconds
DEFAULT_REFRESH_INTERVAL_S=300
REQUIRE_HTTPS=false
ALLOWED_ORIGINS=http://localhost

# ─── Outbound Email (required for email+password signup) ───────────────────
# A new email signup creates NOTHING until the confirmation link is opened,
# so these must work or email signup cannot complete.
#
# MAIL_BACKEND: "http" (a provider API, recommended) or "smtp".
# MAIL_PROVIDER: resend | brevo | postmark | generic  (when MAIL_BACKEND=http)
# MAIL_FROM is what recipients see — use your own domain, never a personal
# mailbox. The domain must be verified with your provider (SPF + DKIM + DMARC).
MAIL_BACKEND=
MAIL_PROVIDER=
MAIL_API_KEY=
# Only for MAIL_PROVIDER=generic: the endpoint to POST JSON to.
MAIL_API_URL=
MAIL_FROM=

# Worked example: Resend on a sending subdomain. The domain must show as
# Verified in the Resend dashboard, which requires either an MX + SPF TXT
# pair or the CNAME pair (rsend.<sub> and <sub>) pointing at *.forge.rmta.net.
# On Cloudflare those CNAMEs must be DNS only (grey cloud) — the orange-cloud
# proxy answers with Cloudflare's own IPs and verification never completes.
#
#   MAIL_BACKEND=http
#   MAIL_PROVIDER=resend
#   MAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
#   MAIL_FROM=noreply@send.yourdomain.com

# ─── SMTP (used when MAIL_BACKEND=smtp) ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ─── Upload storage (listing images) ──────────────────────────────────────
# local = static/uploads/ on disk. Durable ONLY if that path is a persistent
#         volume — on an ephemeral container filesystem images vanish on every
#         redeploy.
# s3    = an S3 (or S3-compatible) bucket.
UPLOAD_BACKEND=local
S3_BUCKET=
S3_REGION=
# Optional: for R2 / MinIO / Wasabi.
S3_ENDPOINT_URL=
# Leave both blank on EC2/Lightsail to use the instance role instead of keys.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN/custom domain in front of the bucket.
S3_PUBLIC_BASE_URL=
# Serves objects as downloads; a useful mitigation if the bucket is ever
# reachable from the app's own origin.
S3_FORCE_DOWNLOAD=false

# ─── Deployment notes ─────────────────────────────────────────────────────
# REQUIRE_HTTPS must be true behind TLS, or the auth cookie is not marked
# Secure and HSTS is disabled.
# APP_BASE_URL must be your real public URL — Google OAuth builds its redirect
# URI from it, so a localhost value breaks sign-in in production.
# Rate-limit counters live in the database, so limits stay correct no matter
# how many uvicorn workers are running.

# ─── Deployment (Lightsail/EC2 via Cloudflare Tunnel) ─────────────────────
# Token for the cloudflared connector, from Zero Trust -> Networks -> Tunnels.
# Only needed for docker-compose.lightsail.yml. Treat it as a credential.
CLOUDFLARE_TUNNEL_TOKEN=
