# .env — environment variables for local development
# Copy .env.example to .env and fill in your values

# ─── Admin Credentials ──────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# ─── Google Sign-In (optional — see docs/GOOGLE-LOGIN.md) ────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google emails allowed to sign in (empty = any account)
GOOGLE_ALLOWED_EMAILS=

# ─── eBay API ───────────────────────────────────────────────────
EBUY_CLIENT_ID=
EBUY_CLIENT_SECRET=
EBAY_REDIRECT_URI=http://localhost:8000/api/auth/ebay/callback

# ─── Etsy API ───────────────────────────────────────────────────
ESY_API_KEY=
ESY_API_SECRET=
ETSY_REDIRECT_URI=http://localhost:8000/api/auth/etsy/callback

# ─── Database ───────────────────────────────────────────────────
DATABASE_URL=sqlite:///./marketplace.db

# ─── App Settings ──────────────────────────────────────────────
APP_PORT=8000
APP_DEBUG=false
# Base URL the browser uses (must match the Google OAuth redirect host)
APP_BASE_URL=http://localhost:8000
# Dashboard auto-refresh interval in seconds
DEFAULT_REFRESH_INTERVAL_S=300
REQUIRE_HTTPS=false
ALLOWED_ORIGINS=http://localhost
